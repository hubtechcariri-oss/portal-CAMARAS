{
  "name": "Portal das Câmaras",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Portal", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/preparar.sh",
  "postAttachCommand": "bash .devcontainer/iniciar.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "batisteo.vscode-django"]
    }
  }
}
